{
  "title": "Cinema Platform Overview",
  "uid": "cinema-overview",
  "tags": ["cinema"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "All Services — Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum by (job) (rate(grpc_server_handled_total[1m]))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 2, "title": "user-service UP", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
      "targets": [{ "expr": "up{job=\"user-service\"}" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] } }
    },
    {
      "id": 3, "title": "booking-service UP", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 8 },
      "targets": [{ "expr": "up{job=\"booking-service\"}" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] } }
    },
    {
      "id": 4, "title": "movie-service UP", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 8 },
      "targets": [{ "expr": "up{job=\"movie-service\"}" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] } }
    },
    {
      "id": 5, "title": "notification-service UP", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 8 },
      "targets": [{ "expr": "up{job=\"notification-service\"}" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] } }
    },
    {
      "id": 6, "title": "api-gateway UP", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "targets": [{ "expr": "up{job=\"api-gateway\"}" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] } }
    },
    {
      "id": 7, "title": "Error Rate by Service", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum by (job) (rate(grpc_server_handled_total{grpc_code!=\"OK\"}[1m]))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 8, "title": "p95 Latency by Service", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (job, le) (rate(grpc_server_handling_seconds_bucket[5m])))", "legendFormat": "{{job}}" }]
    }
  ]
}
